PORT='8000'
NODE_ENV='production'
SPORTMONKS_API_KEY='your_key'
SPORTMONKS_BASE='https://api.sportmonks.com/v3/football'
DBURI="mongodb+srv://<user>:<pass>@<cluster>/<db>?retryWrites=true&w=majority"
DBPW="db_password"
SELF_BASE='https://your-railway-domain.up.railway.app'
FRONTEND_URL='https://thereplay.app'
ADMIN_API_KEY='API_key_here'
OPENAI_API_KEY='OpenAI_key_here'
OPENAI_MODEL='gpt-4o-mini'

# Reporter tweets: leave the official API disabled until paid testing.
TWITTERAPI_KEY=''
REPORTER_TWEET_PROVIDER='twitterapi'
X_API_BEARER_TOKEN=''
X_REPORTER_FALLBACK_ENABLED='false'

# Report posts: off, dry-run, or live. Staging live testing requires explicit opt-in.
X_REPORT_PUBLISH_MODE='off'
X_REPORT_SITE_URL='https://thereplay.app'
X_REPORT_ALLOW_STAGING_LIVE='false'
# Temporary staging-only, API-key-protected fixture diagnostic.
X_FIXTURE_DIAGNOSTIC_ENABLED='false'
X_API_KEY=''
X_API_SECRET=''
X_ACCESS_TOKEN=''
X_ACCESS_TOKEN_SECRET=''

# Cron Job Control (set to 'true' only in production environment)
ENABLE_CRON='false'

# CORS - Additional allowed origins (comma-separated)
# Example: https://staging-preview.pages.dev,https://preview-abc123.pages.dev
CORS_ALLOWED_ORIGINS=''